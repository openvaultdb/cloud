{
  "name": "registry-metadata-search",
  "main": "gateway.mjs",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": { "REGISTRY_SEARCH_MODE": "disabled" },
  "ratelimits": [{ "name": "REGISTRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
