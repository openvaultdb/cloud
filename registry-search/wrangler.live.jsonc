{
  "name": "registry-metadata-search",
  "main": "gateway.mjs",
  "account_id": "01c8a86fc1064f063eb5dd9d101d7001",
  "compatibility_date": "2026-10-07",
  "workers_dev": false,
  "routes": [{ "pattern": "search.openvaultdb.com", "custom_domain": true }],
  "observability": { "enabled": true, "head_sampling_rate": 0.1 },
  "vars": {
    "REGISTRY_SEARCH_MODE": "production",
    "REGISTRY_TYPESENSE_DEPLOYMENT": "vm-pilot",
    "REGISTRY_TYPESENSE_ORIGIN": "https://vm1.sneat.dev/"
  },
  "ratelimits": [{ "name": "REGISTRY_RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 60, "period": 60 } }]
}
