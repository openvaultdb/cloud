{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openvaultdb-cloud",
  "account_id": "01c8a86fc1064f063eb5dd9d101d7001",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "cloud.openvaultdb.com",
      "custom_domain": true
    },
    // DemoDB OVDB API (https://ovdb.demodb.dev/v1); see src/demodb.ts.
    {
      "pattern": "ovdb.demodb.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    // Every path runs the Worker first: the pages need its security headers, and
    // ovdb.demodb.dev (same Worker) must never serve these assets.
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "DEVICE_START_LIMITER",
      "namespace_id": "17031",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DEVICE_LOOKUP_LIMITER",
      "namespace_id": "17032",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    // Public OVDB query routes forwarded to Cloud Run; see src/ovdb-limits.ts.
    {
      "name": "OVDB_QUERY_LIMITER",
      "namespace_id": "17033",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    // Every other public OVDB route forwarded to Cloud Run; see src/ovdb-limits.ts.
    {
      "name": "OVDB_READ_LIMITER",
      "namespace_id": "17034",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    // CORS preflights to public OVDB routes; see src/ovdb-limits.ts.
    {
      "name": "OVDB_PREFLIGHT_LIMITER",
      "namespace_id": "17035",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "vars": {
    "PUBLIC_ORIGIN": "https://cloud.openvaultdb.com",
    "SNEAT_API_ORIGIN": "https://api.sneat.cloud"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
