{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openvaultdb-cloud",
  "account_id": "01c8a86fc1064f063eb5dd9d101d7001",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "cloud.openvaultdb.com",
      "custom_domain": true
    },
    // DemoDB OVDB API (https://ovdb.demodb.dev/v1); see src/demodb.ts.
    {
      "pattern": "ovdb.demodb.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    // Only the paths that need code run the Worker first; everything else
    // (/device/, /devices/, scripts, styles, OAuth discovery metadata) is a free
    // static asset whose headers and redirects live in public/_headers and
    // public/_redirects. ovdb.demodb.dev shares this list: on that host the
    // Worker serves only /v1 and 404s the rest, but the static pages are served
    // there too (marked noindex in public/_headers). See README "Static assets".
    "run_worker_first": [
      // Public OVDB API, rate-limited and forwarded to Cloud Run (ovdb-limits.ts).
      "/v1",
      "/v1/*",
      "/ovdb",
      "/ovdb/*",
      "/.well-known/openvaultdb",
      // Device OAuth flow and device/database management, proxied to Sneat Go.
      "/oauth/*",
      "/api/*",
      // Northwind read-only mirrors (Neon/D1 queries in the Worker).
      "/northwind/*",
      // ECB and IANA operator query routes and the public ECB route.
      "/iana/v1/databases/iana-http-status/dtql",
      "/ecb/v1/databases/ecb/dtql",
      "/ecb-public",
      "/ecb-public/*"
    ],
    "not_found_handling": "404-page"
  },
  "ratelimits": [
    {
      "name": "DEVICE_START_LIMITER",
      "namespace_id": "17031",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DEVICE_LOOKUP_LIMITER",
      "namespace_id": "17032",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    // Public OVDB query routes forwarded to Cloud Run; see src/ovdb-limits.ts.
    {
      "name": "OVDB_QUERY_LIMITER",
      "namespace_id": "17033",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    // Every other public OVDB route forwarded to Cloud Run; see src/ovdb-limits.ts.
    {
      "name": "OVDB_READ_LIMITER",
      "namespace_id": "17034",
      "simple": {
        "limit": 300,
        "period": 60
      }
    },
    // CORS preflights to public OVDB routes; see src/ovdb-limits.ts.
    {
      "name": "OVDB_PREFLIGHT_LIMITER",
      "namespace_id": "17035",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "vars": {
    // Cloud Run service sneat-app (europe-west3), called directly rather than
    // through api.sneat.cloud: that host is the sneat-api-proxy Worker, which
    // only rewrites Host for this traffic, so going through it cost a second
    // Worker invocation per call. X-OVDB-Proxy-Secret is sent by this Worker.
    "SNEAT_API_ORIGIN": "https://sneat-app-354fvnqbaa-ey.a.run.app"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
