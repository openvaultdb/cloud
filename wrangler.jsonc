{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "openvaultdb-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-31",
  "compatibility_flags": ["nodejs_compat"],
  "routes": [
    {
      "pattern": "cloud.openvaultdb.com",
      "custom_domain": true
    }
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./public",
    "run_worker_first": true,
    "not_found_handling": "404-page"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "openvaultdb-cloud",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "ratelimits": [
    {
      "name": "DEVICE_START_LIMITER",
      "namespace_id": "17031",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "DEVICE_LOOKUP_LIMITER",
      "namespace_id": "17032",
      "simple": {
        "limit": 60,
        "period": 60
      }
    }
  ],
  "vars": {
    "FIREBASE_PROJECT_ID": "openvaultdb",
    "PUBLIC_ORIGIN": "https://cloud.openvaultdb.com"
  },
  "triggers": {
    "crons": ["0 4 * * *"]
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.1
    }
  }
}
